{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure CMake (build dir)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build mknixrunner (build dir)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "mknixrunner"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "Configure CMake (build dir)"
            ],
            "dependsOrder": "sequence",
            "detail": "Configures CMake in build/ then builds mknixrunner target"
        }
    ]
}
